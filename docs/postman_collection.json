{
  "info": {
    "name": "MiBici - API de demanda horaria (Equipo 19)",
    "description": "Peticiones de ejemplo para la API de src/serving/app.py (servicio 1.1.0). Levanta el servicio con `uvicorn src.serving.app:app --host 0.0.0.0 --port 8000` (o `docker run -p 8000:8000 ml-service:latest`) y ajusta la variable baseUrl si hace falta. Los ejemplos con rezagos usan filas reales de models/reference_predictions.csv; los ejemplos sin rezagos usan horas de la ventana del feature store (2025-12-24T00:00:00 a 2026-01-01T23:00:00, ver /model-info). Modelo models:/mibici-demand-forecaster/1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y modelo cargado', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().model_loaded).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Model info",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/model-info",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "model-info"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('URI del modelo y SHA-256 verificado', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.model.uri).to.match(/^models:\\/mibici-demand-forecaster\\/\\d+$/);",
              "  pm.expect(body.model_sha256_verified).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - con rezagos (lote válido)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instances\": [\n    {\"station_id\": 24, \"datetime\": \"2025-11-08T10:00:00\", \"demand_lag_24h\": 5.0, \"demand_lag_168h\": 0.0, \"demand_same_hour_mean_7d\": 3.5714285714285716},\n    {\"station_id\": 80, \"datetime\": \"2025-11-08T11:00:00\", \"demand_lag_24h\": 1.0, \"demand_lag_168h\": 2.0, \"demand_same_hour_mean_7d\": 1.4285714285714286}\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/predict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 con una predicción no negativa por instancia y rezagos del cliente', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.n_instances).to.eql(2);",
              "  body.predictions.forEach(p => pm.expect(p.demand_pred).to.be.at.least(0));",
              "  body.predictions.forEach(p => pm.expect(p.lags_source).to.eql('request'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - sin rezagos (feature store)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instances\": [\n    {\"station_id\": 24, \"datetime\": \"2025-12-31T18:00:00\"},\n    {\"station_id\": 80, \"datetime\": \"2026-01-01T08:00:00\"}\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/predict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200: los rezagos los calcula el servicio con el feature store', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.n_instances).to.eql(2);",
              "  body.predictions.forEach(p => pm.expect(p.lags_source).to.eql('feature_store'));",
              "  pm.expect(body.predictions[0].demand_lag_168h).to.eql(1.0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - lote mixto (con y sin rezagos)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instances\": [\n    {\"station_id\": 24, \"datetime\": \"2025-11-08T10:00:00\", \"demand_lag_24h\": 5.0, \"demand_lag_168h\": 0.0, \"demand_same_hour_mean_7d\": 3.5714285714285716},\n    {\"station_id\": 24, \"datetime\": \"2025-12-31T18:00:00\"}\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/predict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200: el origen de los rezagos se indica por instancia', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.predictions.map(p => p.lags_source)).to.eql(['request', 'feature_store']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict raw - fila de la referencia",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rows\": [\n    {\"sin_hour\": 0.49999999999999994, \"cos_hour\": -0.8660254037844387, \"sin_dayofweek\": -0.9749279121818236, \"cos_dayofweek\": -0.2225209339563146, \"latitude\": 20.679389, \"longitude\": -103.35913, \"capacity\": 15, \"demand_lag_24h\": 5.0, \"demand_lag_168h\": 0.0, \"demand_same_hour_mean_7d\": 3.5714285714285716, \"Origen_Id\": 24, \"is_weekend\": 1, \"is_holiday\": 0}\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/predict/raw",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict",
            "raw"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reproduce demand_pred de la referencia', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().predictions[0]).to.eql(2.6064224732591033);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - error de validación (422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instances\": [\n    {\"station_id\": 24, \"datetime\": \"2025-13-45T99:00\", \"demand_lag_24h\": -1, \"demand_lag_168h\": 0.0, \"demand_same_hour_mean_7d\": 3.5714285714285716}\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/predict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 validation_error', function () {",
              "  pm.response.to.have.status(422);",
              "  pm.expect(pm.response.json().error).to.eql('validation_error');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - estación desconocida (404)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instances\": [\n    {\"station_id\": 99999, \"datetime\": \"2025-11-08T10:00:00\", \"demand_lag_24h\": 5.0, \"demand_lag_168h\": 0.0, \"demand_same_hour_mean_7d\": 3.5714285714285716}\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/predict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 con la lista de estaciones desconocidas', function () {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.json().unknown_station_ids).to.eql([99999]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - sin rezagos fuera de la ventana (422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instances\": [\n    {\"station_id\": 24, \"datetime\": \"2025-11-08T10:00:00\"}\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/predict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 con la ventana predecible del feature store', function () {",
              "  pm.response.to.have.status(422);",
              "  const body = pm.response.json();",
              "  pm.expect(body.error).to.eql('outside_feature_store_window');",
              "  pm.expect(body.predictable_window).to.have.property('start');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - rezagos incompletos (422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"instances\": [\n    {\"station_id\": 24, \"datetime\": \"2025-12-31T18:00:00\", \"demand_lag_24h\": 1.0}\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/predict",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "predict"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422: se envían los tres rezagos o ninguno', function () {",
              "  pm.response.to.have.status(422);",
              "  pm.expect(pm.response.json().details[0].type).to.eql('lags_incomplete');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
