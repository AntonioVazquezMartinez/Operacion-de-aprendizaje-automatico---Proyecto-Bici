# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# MLflow data and artifacts
mlruns/
mlflow.db
mlruns.db
mlartifacts/
*.db
*.sqlite
*.sqlite3
.trash/

# Datasets (large files ignored, keeping .gitkeep in raw/interim/processed)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Modelo exportado: desde la versión 1.1.0 la carpeta models/champion/ (modelo MLflow de ~6 MB, catálogo de
# estaciones y feature store) SÍ va en Git para que `docker build` funcione en un clon limpio. DVC la declara
# como salida con `cache: false` (dvc.yaml) y solo guarda su hash en dvc.lock.

# Generic team files
reports/Fase 1_EquipoXX.*

# OS generated files
.DS_Store
Thumbs.db

# Cobertura de pruebas
.coverage
htmlcov/
.pytest_cache/

# Bloqueos temporales de Microsoft Office (documento abierto en Word)
~$*
